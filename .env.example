# Required: Google Gemini API key (free tier is enough). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# LLM settings
LLM_MODEL=gemini-2.5-flash
CONCURRENCY=5

# IO paths
INPUT_PATH=samples/input_requests.csv
OUTPUT_DIR=output

# Optional: Telegram digest (skipped if empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Google Sheets export (skipped if empty)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=keys/service_account.json
